<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <referenceBlock name="page.title">
        <action method="setPageTitle">
            <argument name="title" xsi:type="string">Import</argument>
        </action>
    </referenceBlock>
    <body>
        <referenceContainer name="left">
            <block class="Fulloop\Products\Block\Adminhtml\Import\Edit\Tabs" name="fulloop_products_import_edit_tabs">
                <block class="Fulloop\Products\Block\Adminhtml\Import\Edit\Tab\Main" name="fulloop_products_import_edit_tab_main"/>
                <action method="addTab">
                    <argument name="name" xsi:type="string">main_section</argument>
                    <argument name="block" xsi:type="string">fulloop_products_import_edit_tab_main</argument>
                </action>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Fulloop\Products\Block\Adminhtml\Import\Edit" name="products_import_edit"/>
        </referenceContainer>
    </body>
</page>
