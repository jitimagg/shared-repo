<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">fulloop_pricebot_competitor_form.competitor_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Competitor\Edit\BackButton" name="back"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Competitor\Edit\DeleteButton" name="delete"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Competitor\Edit\SaveButton" name="save"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Competitor\Edit\SaveAndContinueButton" name="save_and_continue"/>
		</buttons>
		<namespace>fulloop_pricebot_competitor_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>fulloop_pricebot_competitor_form.competitor_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="competitor_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider class="Fulloop\Pricebot\Model\Competitor\DataProvider" name="competitor_form_data_source">
			<settings>
				<requestFieldName>competitor_id</requestFieldName>
				<primaryFieldName>competitor_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field formElement="input" name="name" sortOrder="60">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Competitor</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">name</label>
				<dataScope>name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="scraper_class" sortOrder="70">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Competitor</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">scraper_class</label>
				<dataScope>scraper_class</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="textarea" name="targets" sortOrder="80">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Competitor</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">targets</label>
				<dataScope>targets</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="status" sortOrder="90">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Competitor</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">status</label>
				<dataScope>status</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>
