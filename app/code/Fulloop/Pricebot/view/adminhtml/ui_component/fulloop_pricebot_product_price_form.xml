<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">fulloop_pricebot_product_price_form.product_price_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Product\Price\Edit\BackButton" name="back"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Product\Price\Edit\DeleteButton" name="delete"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Product\Price\Edit\SaveButton" name="save"/>
			<button class="Fulloop\Pricebot\Block\Adminhtml\Product\Price\Edit\SaveAndContinueButton" name="save_and_continue"/>
		</buttons>
		<namespace>fulloop_pricebot_product_price_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>fulloop_pricebot_product_price_form.product_price_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="product_price_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider class="Fulloop\Pricebot\Model\ProductPrice\DataProvider" name="product_price_form_data_source">
			<settings>
				<requestFieldName>product_price_id</requestFieldName>
				<primaryFieldName>product_price_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field formElement="input" name="product_title" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Product_Price</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">product_title</label>
				<dataScope>product_title</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="competitor_id" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Product_Price</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">competitor_id</label>
				<dataScope>competitor_id</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="price" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Product_Price</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">price</label>
				<dataScope>price</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="views_count" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Product_Price</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">views_count</label>
				<dataScope>views_count</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="textarea" name="url" sortOrder="50">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Product_Price</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">url</label>
				<dataScope>url</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>
