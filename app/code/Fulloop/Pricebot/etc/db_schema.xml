<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table comment="fulloop_pricebot_product_price Table" engine="innodb" name="fulloop_pricebot_product_price" resource="default">
		<column comment="Entity Id" identity="true" name="product_price_id" nullable="false" padding="6" unsigned="true" xsi:type="smallint"/>
		<constraint referenceId="PRIMARY" xsi:type="primary">
			<column name="product_price_id"/>
		</constraint>
		<column length="255" name="product_title" nullable="true" xsi:type="varchar"/>
		<column length="255" name="competitor_id" nullable="false" xsi:type="varchar"/>
		<column name="price" nullable="true" xsi:type="float"/>
		<column identity="false" name="views_count" nullable="true" xsi:type="int"/>
		<column name="url" nullable="true" xsi:type="text"/>
	</table>
	<table comment="fulloop_pricebot_competitor Table" engine="innodb" name="fulloop_pricebot_competitor" resource="default">
		<column comment="Entity Id" identity="true" name="competitor_id" nullable="false" padding="6" unsigned="true" xsi:type="smallint"/>
		<constraint referenceId="PRIMARY" xsi:type="primary">
			<column name="competitor_id"/>
		</constraint>
		<column length="255" name="name" nullable="true" xsi:type="varchar"/>
		<column length="255" name="scraper_class" nullable="true" xsi:type="varchar"/>
		<column name="targets" nullable="true" xsi:type="text"/>
		<column length="255" name="status" nullable="true" xsi:type="varchar"/>
	</table>
	<table comment="fulloop_pricebot_process_log Table" engine="innodb" name="fulloop_pricebot_process_log" resource="default">
		<column comment="Entity Id" identity="true" name="process_log_id" nullable="false" padding="6" unsigned="true" xsi:type="smallint"/>
		<constraint referenceId="PRIMARY" xsi:type="primary">
			<column name="process_log_id"/>
		</constraint>
		<column name="message" nullable="true" xsi:type="text"/>
	</table>
</schema>
