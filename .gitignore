# ======================
# Magento 2 core
# ======================
/vendor/
/generated/
/pub/static/
/pub/media/tmp/
/var/
/app/etc/env.php
/app/etc/config.php

# บางส่วนใน var อาจต้องยกเว้นตามที่ต้องการ
!/var/.htaccess

# ======================
# Composer / PHP
# ======================
*.log
*.php_cs.cache
*.cache
*.lock
*.tmp
*.bak

# ======================
# Node.js / Frontend tools
# ======================
/node_modules/
/package-lock.json
/yarn.lock
/.pnp/
/.pnp.js
/dist/
/build/

# ======================
# Environment / Secrets
# ======================
.env
.env.*
!.env.example

# ======================
# IDEs / Editors
# ======================
.idea/
*.iml
.vscode/
*.sublime*
*.code-workspace

# ======================
