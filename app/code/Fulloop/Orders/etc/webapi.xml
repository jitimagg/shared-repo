<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route method="POST" url="/V1/fulloop-orders/response">
        <service class="Fulloop\Orders\Api\ResponseManagementInterface" method="postResponse"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route method="POST" url="/V1/fulloop-orders/set-quote">
        <service class="Fulloop\Orders\Api\SetQuoteInterface" method="postResponse"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
