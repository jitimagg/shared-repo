<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_listing_data_source</item>
		</item>
	</argument>
	<settings>
		<spinner>fulloop_pricebot_product_price_columns</spinner>
		<deps>
			<dep>fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_listing_data_source</dep>
		</deps>
		<buttons>
			<button name="add">
				<url path="*/*/new"/>
				<class>primary</class>
				<label translate="true">Add new Product_Price</label>
			</button>
		</buttons>
	</settings>
	<dataSource component="Magento_Ui/js/grid/provider" name="fulloop_pricebot_product_price_listing_data_source">
		<settings>
			<updateUrl path="mui/index/render"/>
		</settings>
		<aclResource>Fulloop_Pricebot::Product_Price</aclResource>
		<dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="fulloop_pricebot_product_price_listing_data_source">
			<settings>
				<requestFieldName>id</requestFieldName>
				<primaryFieldName>product_price_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<listingToolbar name="listing_top">
		<settings>
			<sticky>true</sticky>
		</settings>
		<bookmark name="bookmarks"/>
		<columnsControls name="columns_controls"/>
		<filters name="listing_filters"/>
		<paging name="listing_paging"/>
	</listingToolbar>
	<columns name="fulloop_pricebot_product_price_columns">
		<settings>
			<editorConfig>
				<param name="selectProvider" xsi:type="string">fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_columns.ids</param>
				<param name="enabled" xsi:type="boolean">true</param>
				<param name="indexField" xsi:type="string">product_price_id</param>
				<param name="clientConfig" xsi:type="array">
					<item name="saveUrl" path="fulloop_pricebot/ProductPrice/inlineEdit" xsi:type="url"/>
					<item name="validateBeforeSave" xsi:type="boolean">false</item>
				</param>
			</editorConfig>
			<childDefaults>
				<param name="fieldAction" xsi:type="array">
					<item name="provider" xsi:type="string">fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_listing.fulloop_pricebot_product_price_columns_editor</item>
					<item name="target" xsi:type="string">startEdit</item>
					<item name="params" xsi:type="array">
						<item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
						<item name="1" xsi:type="boolean">true</item>
					</item>
				</param>
			</childDefaults>
		</settings>
		<selectionsColumn name="ids">
			<settings>
				<indexField>product_price_id</indexField>
			</settings>
		</selectionsColumn>
		<column name="product_price_id">
			<settings>
				<filter>text</filter>
				<sorting>asc</sorting>
				<label translate="true">ID</label>
			</settings>
		</column>
		<column name="product_title">
			<settings>
				<filter>text</filter>
				<label translate="true">product_title</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
		<column name="competitor_id">
			<settings>
				<filter>text</filter>
				<label translate="true">competitor_id</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
		<column name="price">
			<settings>
				<filter>text</filter>
				<label translate="true">price</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
		<column name="views_count">
			<settings>
				<filter>text</filter>
				<label translate="true">views_count</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
		<column name="url">
			<settings>
				<filter>text</filter>
				<label translate="true">url</label>
				<editor>
					<editorType>text</editorType>
					<validation>
						<rule name="required-entry" xsi:type="boolean">false</rule>
					</validation>
				</editor>
			</settings>
		</column>
        <actionsColumn class="Fulloop\Pricebot\Ui\Component\Listing\Column\ProductPriceActions" name="actions">
            <settings>
                <indexField>product_price_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
	</columns>
</listing>
